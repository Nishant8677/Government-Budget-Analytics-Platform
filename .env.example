# BudgetIQ — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=***REMOVED***
DB_NAME=budgetiq

# ── Application ───────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
