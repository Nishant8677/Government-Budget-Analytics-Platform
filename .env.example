# BudgetIQ — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
#
# This file is a template. Every value below is a placeholder and none of them
# are real credentials. Do not paste a working password in here.

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
# root works for local setup because setup_db.py issues CREATE DATABASE. For
# anything beyond a local machine, create a dedicated user granted only on
# budgetiq.* instead of reusing the server's root account.
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=budgetiq

# ── Application ───────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
